{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webapp-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9b35678d-9d8b-4d4b-8686-791a1d5b8c7d","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8d2170a82490461fb4280bcbb870bf42" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
